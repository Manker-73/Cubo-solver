{
  "name": "cubo-solver",
  "version": "0.1.0",
  "description": "Generador de scrambles WCA, validador de estado y solucionador visual de puzzles (web, sin servidor)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"tests/*.test.mjs\"",
    "test:rapido": "node scripts/tests.mjs rapido",
    "test:humo": "node scripts/tests.mjs humo",
    "test:solo": "node scripts/tests.mjs solo",
    "tipos": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "typescript": "^7.0.2"
  }
}
